// Cloudflare Worker for gradecalc.aidanwbrown.com (Worker "gradecalc", deployed by Workers Builds on push to main).
// Public site: no Cloudflare Access. The static page in ./site is served straight from assets; the Worker runs first
// only for /api/* and /auth/* (accounts, sync). Secrets (wrangler secret put, never in git): see README "Hosting".
{
  "name": "gradecalc",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",

  // Copies shared/calc.js into ./site/js before every `wrangler dev` / `wrangler deploy` (the copy is gitignored).
  "build": { "command": "node scripts/build.mjs" },

  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/auth/*"]
  },

  // Accounts, sessions, one gradebook row per user. Separate from the private Gradebook database on purpose.
  "d1_databases": [
    { "binding": "gradecalc", "database_name": "gradecalc", "database_id": "3c304d47-db95-46d4-80ab-c55ccd9facc1", "migrations_dir": "migrations" }
  ],

  // Not secret. PUBLIC_ORIGIN fixes the OAuth redirect URIs and the allowed Origin for writes (.dev.vars overrides it
  // locally). ADMIN_LABEL is only a heading on the admin page: admin = a Google sign-in whose subject is the ADMIN_SUB secret
  // (set with `wrangler secret put ADMIN_SUB`, never here).
  "vars": {
    "PUBLIC_ORIGIN": "https://gradecalc.aidanwbrown.com",
    "ADMIN_LABEL": "GradeCalc admin"
  },

  // Rate limits (per Cloudflare location, 60 s windows): sign-in 20 per IP, API 600 per IP (campus WiFi shares one IP),
  // API 120 per signed-in user, writes 60 per user. A missing binding fails closed (the Worker answers 429).
  "ratelimits": [
    { "name": "RL_AUTH", "namespace_id": "1501", "simple": { "limit": 20, "period": 60 } },
    { "name": "RL_API", "namespace_id": "1502", "simple": { "limit": 600, "period": 60 } },
    { "name": "RL_USER", "namespace_id": "1504", "simple": { "limit": 120, "period": 60 } },
    { "name": "RL_WRITE", "namespace_id": "1503", "simple": { "limit": 60, "period": 60 } }
  ],

  "observability": { "enabled": true },

  // Only this domain. The workers.dev address and preview URLs stay off (one public address, one set of cookies).
  "routes": [
    { "pattern": "gradecalc.aidanwbrown.com", "custom_domain": true }
  ],
  "workers_dev": false,
  "preview_urls": false,
  "dev": { "host": "localhost" }
}
