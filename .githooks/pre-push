#!/bin/sh
# LeakGuard before every push. Enable once per clone: npm run hooks  (git config core.hooksPath .githooks)
# Checks the commits being pushed (messages + added lines) and every tracked file.
while read local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "0000000000000000000000000000000000000000" ] && continue
  if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then r="$local_sha"; else r="$remote_sha..$local_sha"; fi
  node scripts/leakguard.mjs --range "$r" || exit 1
done
exit 0
